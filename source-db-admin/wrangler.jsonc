{
  // ローカル専用。Cloudflareへのデプロイ対象はsource/のみ。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workers-starter-db-admin",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-14",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "workers-starter-db",
      // source/wrangler.jsoncと同じID・Composeの状態ボリュームを使う。
      "database_id": "00000000-0000-4000-8000-000000000001"
    }
  ]
}
