{
  "name": "cloudflare-workers-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run db:migrate:local && wrangler dev",
    "deploy": "npm run db:migrate:remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply workers-starter-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply workers-starter-db --remote",
    "check": "npm run cf-typegen && tsc --noEmit",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "wrangler": "^4.151.0"
  }
}
