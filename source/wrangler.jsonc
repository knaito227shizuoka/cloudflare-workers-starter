{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-workers-starter",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-14",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "workers-starter-db",
      "database_id": "d1dbbbbc-5738-4844-8d7f-084564393eaa",
      // ローカル開発用ID。管理画面と揃え、既存のローカルDBを引き継ぐ。
      "preview_database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "./migrations"
    }
  ]
}
